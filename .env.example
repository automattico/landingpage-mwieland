SFTP_HOST=example.com
SFTP_PORT=22
SFTP_USER=your-sftp-username
SFTP_REMOTE_DIR=/public_html/landingpage
# SSH key auth only — SFTP_PASSWORD is not supported; deploy.sh refuses to run if it is set.
# Public key of the deploy key; the private half lives in the SSH agent (Bitwarden desktop app).
SFTP_KEY_PATH=/Users/your-user/.ssh/id_ed25519_hetzner.pub
# Optional: agent socket for shells that do not export SSH_AUTH_SOCK.
# SFTP_IDENTITY_AGENT=/Users/your-user/.bitwarden-ssh-agent.sock
# Pinned host keys (committed). Populate once: ssh-keyscan -p 22 $SFTP_HOST >> deploy/known_hosts
SFTP_KNOWN_HOSTS=deploy/known_hosts

SITE_URL=https://example.com
PREVIEW_SITE_URL=https://preview.example.com
RUN_PROD_GATE=1
RUN_POST_DEPLOY_HEALTHCHECK=1
RUN_CLOUDFLARE_PURGE=1
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
SMOKE_TEST_PORT=8123
